PORT=5001
DATABASE_URL=postgresql://postgres:password123@localhost:5432/ai_roleplay?schema=public
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Developer toggles
USE_MOCKS=true
SAVE_DEBUG_RECORDINGS=true

# STT (Whisper.cpp) — only required when USE_MOCKS=false
WHISPER_BINARY_PATH=/app/whisper/main
WHISPER_MODEL_PATH=/app/whisper/models/ggml-base.en.bin

# AI API Keys
OPENROUTER_API_KEY=your_openrouter_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# LLM Configuration (Phase 4)
LLM_MODEL=deepseek/deepseek-chat
MAX_CONTEXT_MESSAGES=10

# Session Configuration (Phase 6)
SESSION_TIMEOUT=180000

# TTS Configuration (Phase 5/6)
TTS_TOKEN_THRESHOLD=15

# TTS/STT Providers
TTS_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Sentry DSN
SENTRY_DSN=your_backend_sentry_dsn
