{
  "name": "ai-english-roleplay-backend",
  "version": "1.0.0",
  "description": "Realtime AI English Roleplay Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:seed": "dotenv -e .env.local -- prisma db seed",
    "architecture:check": "node scripts/check-architecture.js",
    "smoke:speaking": "node scripts/smoke-speaking-slice.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "_moduleAliases": {
    "@config":      "./config",
    "@services":    "./src/services",
    "@sockets":     "./src/sockets",
    "@middleware":  "./src/middleware",
    "@controllers": "./src/controllers",
    "@utils":       "./src/utils",
    "@routes":      "./src/routes"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "ai-english-roleplay-web-app": "file:..",
    "shared-contracts": "file:../packages/shared-contracts",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.3.4",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2"
  }
}
